<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Job Seeker Copilot – Custom Checkstyle Ruleset
    Lightweight: focuses on naming, imports, Javadoc, and file structure.
-->
<module name="Checker">

    <!-- Allow 120-character lines (generous for modern screens) -->
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="${severity}"/>
    <property name="fileExtensions" value="java"/>

    <!-- ================================================================
         FILE-LEVEL CHECKS
         ================================================================ -->
    <!-- files must end with a newline -->
    <module name="NewlineAtEndOfFile"/>

    <!-- tabs not allowed – use spaces -->
    <module name="FileTabCharacter"/>

    <!-- enforce package-info.java convention -->
    <module name="JavadocPackage">
        <property name="allowLegacy" value="true"/>
    </module>

    <!-- ================================================================
         TREE CHECKS (applied to the AST of each file)
         ================================================================ -->
    <module name="TreeWalker">

        <!-- ======================== NAMING CONVENTIONS =============== -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
        </module>

        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <module name="StaticVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- ======================== IMPORTS ========================== -->
        <module name="IllegalImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>

        <!-- ======================== JAVADOC ========================== -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
            <property name="validateThrows" value="false"/>
            <property name="tokens" value="METHOD_DEF,ANNOTATION_FIELD_DEF"/>
        </module>

        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="allowMissingPropertyJavadoc" value="true"/>
            <property name="ignoreMethodNamesRegex" value="^(main|toString|equals|hashCode|builder|of|from|valueOf)$"/>
            <!-- at least one sentence on public methods -->
        </module>

        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="true"/>
            <property name="checkEmptyJavadoc" value="false"/>
        </module>

        <!-- ======================== CODING STYLE ==================== -->
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <module name="NeedBraces"/>

        <module name="LeftCurly">
            <property name="option" value="eol"/>
        </module>

        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>

        <module name="OneStatementPerLine"/>

        <module name="MultipleVariableDeclarations"/>

        <module name="ArrayTypeStyle"/>

        <module name="ModifierOrder"/>

        <module name="DefaultComesLast"/>

        <module name="UpperEll"/>

        <!-- ======================== SIZE LIMITS (generous) ========== -->
        <module name="MethodLength">
            <property name="max" value="80"/>
            <property name="countEmpty" value="false"/>
        </module>

        <module name="ParameterNumber">
            <property name="max" value="10"/>
        </module>

    </module>
</module>