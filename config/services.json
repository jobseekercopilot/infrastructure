{
  "schemaVersion": 2,
  "organisation": "jobseekercopilot",
  "githubProject": {
    "title": "Job Seeker Copilot",
    "number": 1
  },
  "workspace": {
    "layout": "sibling-repositories",
    "infrastructurePath": "infrastructure",
    "defaultBranch": "develop",
    "lock": "config/workspace-lock.json",
    "runtimeEnvironmentSchema": "config/runtime-environment.schema.json"
  },
  "profiles": {
    "basic-fixture": {
      "description": "Registration, profile, location and fixture-backed job search.",
      "composeFiles": ["docker-compose.yml"],
      "composeProject": "job-seeker-copilot-basic",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": [
        "authentication-postgres",
        "authentication-service",
        "user-profile-service",
        "user-management-gateway",
        "application-tracker-postgres",
        "application-tracker-service",
        "system-data-service",
        "postcode-io-gateway",
        "google-maps-gateway",
        "location-service",
        "location-gateway",
        "reed-gateway",
        "adzuna-gateway",
        "jsearch-gateway",
        "nhs-jobs-gateway",
        "apprenticeships-gateway",
        "job-matching-service",
        "job-service",
        "job-finder-gateway",
        "job-seeker-copilot-client"
      ]
    },
    "full-fixture": {
      "description": "The complete private-beta application with every external integration fixture-backed.",
      "composeFiles": ["docker-compose.yml"],
      "composeProject": "job-seeker-copilot-full",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "e2e": {
      "description": "The complete isolated browser-test application with fixture-backed providers, named-state controls and loopback-only host ports.",
      "composeFiles": [
        "docker-compose.yml",
        "docker-compose.e2e.yml",
        "docker-compose.low-memory.yml"
      ],
      "composeProject": "job-seeker-copilot-e2e",
      "composeParallelLimit": 1,
      "environmentProfile": "e2e",
      "environmentFile": ".env.e2e",
      "frontendUrl": "http://localhost:3100",
      "services": "all-runtime"
    },
    "full-local-ses": {
      "description": "The complete fixture-backed private-beta application with account email sent through the production SES adapter to LocalStack.",
      "composeFiles": ["docker-compose.yml", "docker-compose.local-ses.yml"],
      "composeProject": "job-seeker-copilot-full-local-ses",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "google-maps-smoke": {
      "description": "The complete fixture-backed private-beta application with only Google Maps live for bounded validation.",
      "composeFiles": [
        "docker-compose.yml",
        "docker-compose.real-google-maps.yml",
        "docker-compose.low-memory.yml"
      ],
      "composeProject": "job-seeker-copilot-google-maps",
      "composeParallelLimit": 1,
      "environmentProfile": "local",
      "environmentFile": ".env.google-maps-smoke",
      "secretEnvironmentFile": "config/.secrets.env",
      "secretProviders": ["GOOGLE"],
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "real-job-providers": {
      "description": "The complete private-beta application with Reed, Adzuna, JSearch, NHS Jobs, Find an apprenticeship and the Postcodes.io location authority live while LLM and Stripe remain fixture-backed.",
      "composeFiles": ["docker-compose.yml", "docker-compose.real-job-providers.yml"],
      "composeProject": "job-seeker-copilot-real-jobs",
      "environmentProfile": "local",
      "environmentFile": ".env.real-job-providers",
      "secretEnvironmentFile": "config/.secrets.env",
      "secretProviders": ["REED", "ADZUNA", "JSEARCH", "APPRENTICESHIPS"],
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "real-providers": {
      "description": "The complete private-beta application with real job providers, Postcodes.io, Google Maps and real AWS Bedrock document generation while Stripe remains fixture-backed.",
      "composeFiles": [
        "docker-compose.yml",
        "docker-compose.real-job-providers.yml",
        "docker-compose.real-bedrock.yml",
        "docker-compose.real-google-maps.yml",
        "docker-compose.low-memory.yml"
      ],
      "composeProject": "job-seeker-copilot-real-jobs",
      "composeParallelLimit": 1,
      "environmentProfile": "local",
      "environmentFile": ".env.real-job-providers",
      "secretEnvironmentFile": "config/.secrets.env",
      "secretProviders": ["REED", "ADZUNA", "JSEARCH", "APPRENTICESHIPS", "GOOGLE"],
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    }
  },
