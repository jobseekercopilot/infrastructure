{
  "schemaVersion": 2,
  "organisation": "jobseekercopilot",
  "githubProject": {
    "title": "Job Seeker Copilot",
    "number": 1
  },
  "workspace": {
    "layout": "sibling-repositories",
    "infrastructurePath": "infrastructure",
    "defaultBranch": "develop",
    "lock": "config/workspace-lock.json",
    "runtimeEnvironmentSchema": "config/runtime-environment.schema.json"
  },
  "profiles": {
    "basic-fixture": {
      "description": "Registration, profile, location and fixture-backed job search.",
      "composeFiles": ["docker-compose.yml"],
      "composeProject": "job-seeker-copilot-basic",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": [
        "authentication-postgres",
        "authentication-service",
        "user-profile-service",
        "user-management-gateway",
        "application-tracker-postgres",
        "application-tracker-service",
        "system-data-service",
        "postcode-io-gateway",
        "location-gateway",
        "reed-gateway",
        "adzuna-gateway",
        "jsearch-gateway",
        "job-matching-service",
        "job-service",
        "job-finder-gateway",
        "job-seeker-copilot-client"
      ]
    },
    "full-fixture": {
      "description": "The complete private-beta application with every external integration fixture-backed.",
      "composeFiles": ["docker-compose.yml"],
      "composeProject": "job-seeker-copilot-full",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "full-local-ses": {
      "description": "The complete fixture-backed private-beta application with account email sent through the production SES adapter to LocalStack.",
      "composeFiles": ["docker-compose.yml", "docker-compose.local-ses.yml"],
      "composeProject": "job-seeker-copilot-full-local-ses",
      "environmentProfile": "local",
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "real-job-providers": {
      "description": "The complete private-beta application with Reed, Adzuna and JSearch live while LLM and Stripe remain fixture-backed.",
      "composeFiles": ["docker-compose.yml", "docker-compose.real-job-providers.yml"],
      "composeProject": "job-seeker-copilot-real-jobs",
      "environmentProfile": "local",
      "secretEnvironmentFile": "config/.secrets.env",
      "secretProviders": ["REED", "ADZUNA", "JSEARCH"],
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    },
    "real-providers": {
      "description": "The complete private-beta application with real job providers and real OpenAI document generation while Stripe remains fixture-backed.",
      "composeFiles": [
        "docker-compose.yml",
        "docker-compose.real-job-providers.yml",
        "docker-compose.real-openai.yml"
      ],
      "composeProject": "job-seeker-copilot-real-jobs",
      "environmentProfile": "local",
      "secretEnvironmentFile": "config/.secrets.env",
      "secretProviders": ["REED", "ADZUNA", "JSEARCH", "OPENAI"],
      "frontendUrl": "http://localhost:3000",
      "services": "all-runtime"
    }
  },
  "buildOrder": [
    "authentication-service",
    "user-profile-service",
    "postcode-io-gateway",
    "application-tracker-service",
    "document-store-service",
    "payment-service",
    "reed-gateway",
    "adzuna-gateway",
    "jsearch-gateway",
    "llm-gateway",
    "stripe-gateway",
    "location-gateway",
    "user-management-gateway",
    "job-matching-service",
    "job-service",
    "document-export-service",
    "cv-cover-letter-service",
    "reporting-service",
    "payment-gateway",
    "job-finder-gateway",
    "document-generation-gateway",
    "reporting-gateway",
    "system-data-service",
    "job-seeker-copilot-client",
    "e2e"
  ],
  "repositories": [
    {
      "name": "authentication-service",
      "kind": "service",
      "branch": "develop",
      "build": "maven",
      "composeServices": ["authentication-service"],
      "port": 8084,
      "health": "/actuator/health",
      "dependsOn": []
    },
    {
      "name": "user-profile-service",
      "kind": "service",
      "branch": "develop",
      "build": "maven",
