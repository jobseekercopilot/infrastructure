      "composeServices": ["adzuna-gateway"],
      "port": 8101,
      "health": "/actuator/health",
      "dependsOn": ["system-data-service"]
    },
    {
      "name": "jsearch-gateway",
      "kind": "gateway",
      "branch": "develop",
