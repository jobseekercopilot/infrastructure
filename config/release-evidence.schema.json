{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jobseekercopilot/infrastructure/config/release-evidence.schema.json",
  "title": "Job Seeker Copilot release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "createdAt",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "$ref": "#/$defs/timestamp"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceFile": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNKNOWN"
          ]
        },
        "spdxId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "findingIds",
        "owner",
        "justification",
        "expiresAt",
        "compensatingControl"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "findingIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "$ref": "#/$defs/timestamp"
        },
        "compensatingControl": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "owner",
        "source",
        "builder",
        "artifact",
        "sbom",
        "vulnerabilityScan",
        "licenceScan",
        "provenance",
        "signature",
        "secretScan",
        "exceptions"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "container-image",
            "java-package",
            "web-bundle",
            "infrastructure"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/jobseekercopilot/[A-Za-z0-9._-]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "builder": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "invocation"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "invocation": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "digest"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "sbom": {
          "unevaluatedProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/evidenceFile"
            },
            {
              "type": "object",
              "required": [
                "format"
              ],
              "properties": {
                "format": {
                  "enum": [
                    "CycloneDX-1.5",
                    "CycloneDX-1.6",
                    "SPDX-2.3"
                  ]
                }
              }
            }
          ]
        },
        "vulnerabilityScan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scanner",
            "version",
            "completedAt",
            "databaseUpdatedAt",
            "report",
            "reportSha256",
            "findings"
          ],
          "properties": {
            "scanner": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "completedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "databaseUpdatedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "reportSha256": {
              "$ref": "#/$defs/sha256"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        "licenceScan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scanner",
            "version",
            "completedAt",
            "report",
            "reportSha256",
            "findings"
          ],
          "properties": {
            "scanner": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "completedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "reportSha256": {
              "$ref": "#/$defs/sha256"
            },
            "findings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/finding"
              }
            }
          }
        },
        "provenance": {
          "unevaluatedProperties": false,
          "allOf": [
            {
              "$ref": "#/$defs/evidenceFile"
            },
            {
              "type": "object",
              "required": [
                "predicateType"
              ],
              "properties": {
                "predicateType": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme",
            "identity",
            "issuer",
            "verification",
            "verificationSha256"
          ],
          "properties": {
            "scheme": {
              "type": "string",
              "minLength": 1
            },
            "identity": {
              "type": "string",
              "minLength": 1
            },
            "issuer": {
              "type": "string",
              "minLength": 1
            },
            "verification": {
              "type": "string",
              "minLength": 1
            },
            "verificationSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "secretScan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scanner",
            "version",
            "scope",
            "completedAt",
            "commitsScanned",
            "bytesScanned",
            "report",
            "reportSha256"
          ],
          "properties": {
            "scanner": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "scope": {
              "const": "all-reachable-history"
            },
            "completedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "commitsScanned": {
              "type": "integer",
              "minimum": 1
            },
            "bytesScanned": {
              "type": "integer",
              "minimum": 1
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "reportSha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "exceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/exception"
          }
        }
      }
    }
  }
}
